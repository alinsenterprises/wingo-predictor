# ---------------------------------------------------------------------------
# Wingo prediction analyzer - environment template
# Copy to .env (local) or /etc/wingo-analyzer.env (Lightsail systemd) and fill in.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# --- dmfirst1.com account ---------------------------------------------------
# The marketing site (dmfirst1.com) is only a shell: every XHR is a signed JSON
# POST to the API host below under the /api/webapi prefix.
DMFIRST_BASE_URL=https://api.dmfirst9api.com
# Sent as the Ar-Origin header (the site's own origin).
DMFIRST_ORIGIN=https://dmfirst1.com
DMFIRST_USERNAME=
DMFIRST_PASSWORD=
# Optional: paste an already-authenticated session token to skip the login call.
# DMFIRST_TOKEN=
# Set to false to never call the login endpoint (the history list is public).
# Use it while the credentials are wrong: each process start would otherwise
# spend one of the site's 10 failed-password slots.
DMFIRST_LOGIN=true

# --- login request ----------------------------------------------------------
# POST path (relative to BASE_URL) used for authentication.
DMFIRST_LOGIN_PATH=/api/webapi/Login
# json = send JSON body, form = send application/x-www-form-urlencoded
DMFIRST_LOGIN_MODE=json
# JSON body template. Placeholders: $username $password $login_type
# ($login_type is "email" when the username contains @, else "mobile").
DMFIRST_LOGIN_TEMPLATE={"username": "$username", "pwd": "$password", "logintype": "$login_type"}
# Where to find the bearer token in the login response (dot path, blank = auto).
DMFIRST_LOGIN_TOKEN_PATH=
# Header used to send the token on later requests.
DMFIRST_LOGIN_TOKEN_HEADER=
# Prefix in front of the token, e.g. "Bearer " (leave empty for raw tokens).
DMFIRST_LOGIN_TOKEN_PREFIX=

# --- request signing --------------------------------------------------------
# The API rejects any body without language/random/timestamp/signature
# (an MD5 over the sorted, non-empty fields). Keep this on.
DMFIRST_SIGN=true
# Site language index (0 = English).
DMFIRST_LANGUAGE=0
# Legacy single-game knob, superseded by WINGO_MODES below.
# DMFIRST_TYPE_ID=1

# --- the four games (one browser head each) --------------------------------
# Defaults to all four: 30sec=30, 1min=1, 3min=2, 5min=3 (name=typeId).
# Narrow it to run fewer games, e.g. WINGO_MODES=30sec=30,1min=1
WINGO_MODES=
# Game used when a command does not name one (bot /stats, CLI --mode).
DEFAULT_MODE=1min
# Which games push to Telegram: all, or a comma list like 1min,5min
# (all four produce roughly 5 000 messages/day).
NOTIFY_MODES=all

# --- results / history endpoint --------------------------------------------
# json | html | auto   (auto tries JSON first, then falls back to the HTML table)
DMFIRST_RESULTS_MODE=auto
# Public: the history list does not require a session, so scraping keeps
# working even while the login credentials are wrong.
DMFIRST_RESULTS_PATH=/api/webapi/GetNoaverageEmerdList
DMFIRST_RESULTS_METHOD=POST
# JSON body; $page, $page_size and $type_id are substituted.
DMFIRST_RESULTS_TEMPLATE={"typeId": $type_id, "pageNo": $page, "pageSize": $page_size}
# Dot path to the array of records inside the JSON response ("" = response is the array)
DMFIRST_RESULTS_LIST_PATH=data.list
# Field names inside one record (blank = try common aliases automatically)
DMFIRST_FIELD_PERIOD=issueNumber
DMFIRST_FIELD_NUMBER=number
# Blank: dmfirst's "premium" just repeats the drawn number on settled rounds,
# so it is not a prediction. Set it only if the site publishes a real pick.
DMFIRST_FIELD_PREDICTED=
DMFIRST_FIELD_TIME=
# HTML fallback selectors (RESULTS_MODE=html/auto)
DMFIRST_HTML_ROW_SELECTOR=table tbody tr
DMFIRST_HTML_CELL_SELECTOR=td
# 1-based cell positions, e.g. period=1,number=2,time=3
DMFIRST_HTML_MAP=period=1,number=2,time=3
# Politeness + transport
DMFIRST_PAGE_SIZE=60
DMFIRST_REQUEST_TIMEOUT=20
DMFIRST_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
DMFIRST_TLS_VERIFY=true

# --- dataset (the "history" folder: everything we predicted and saw) -------
# SQLite file (created on first run) - rounds + predictions for all 4 games.
DB_PATH=data/wingo.db
# Append-only JSONL archive per game: every prediction, result and score.
HISTORY_DIR=data/history
# Keep only the newest N rounds PER GAME; older rows are deleted automatically.
# Must be > 500 to satisfy the "more than 500 previous predictions" requirement.
MAX_RECORDS=600
# How many rounds to fetch on the very first run to seed the dataset.
BACKFILL_TARGET=550
BACKFILL_MAX_PAGES=40

# --- analysis / polling -----------------------------------------------------
ANALYSIS_WINDOW=100
POLL_INTERVAL_SECONDS=20
ROUND_SECONDS=60
# Watchdog: a cycle taking longer than this is killed and that game's
# browser head is rebuilt - this is what keeps the service up 24/7.
CYCLE_TIMEOUT_SECONDS=120

# --- browser heads + photos --------------------------------------------------
# auto = scrape through Chromium with an automatic http fallback,
# browser = Chromium only, http = plain requests (no photos).
TRANSPORT=auto
BROWSER_HEADLESS=true
# Required when the service runs as root (most VMs/containers).
BROWSER_NO_SANDBOX=true
BROWSER_LAUNCH_TIMEOUT=30
# Page the heads sit on when taking photos (blank = DMFIRST_ORIGIN).
PAGE_URL=
# The "photos" folder: one photo per game every SNAPSHOT_INTERVAL_SECONDS and
# one on every error, saved as snapshots/<game>/<date>/<time>_<reason>.jpg.
SNAPSHOT_DIR=snapshots
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SECONDS=120
SNAPSHOT_ON_ERROR=true
SNAPSHOT_FORMAT=jpeg
SNAPSHOT_QUALITY=72
# Retention so 24/7 capture can never fill the disk:
# photos older than N days are deleted, and each game keeps at most N files.
SNAPSHOT_RETENTION_HOURS=24
SNAPSHOT_MAX_FILES=720

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids that always get updates (optional; /start subscribes too).
TELEGRAM_ADMIN_CHAT_IDS=
NOTIFY_ON_NEW_ROUND=true
NOTIFY_ON_RESULT=true

# --- Gemini (optional AI commentary) ---------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_CHARS=600

# --- status endpoint ---------------------------------------------------------
# GET / (or /healthz) returns the same snapshot as the Telegram /status command.
# The platform's injected PORT is used when STATUS_PORT is unset.
STATUS_HOST=0.0.0.0
STATUS_PORT=8080

# --- runtime ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=logs/analyzer.log
